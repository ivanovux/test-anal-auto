# Скопируйте в .env и при необходимости поправьте
SOURCES=drom,autoru
MAX_PAGES=5
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
COLLECT_HOUR=4
COLLECT_MINUTE=17
REGION_DROM=
REGION_AUTORU=rossiya
# SCRAPER_PROXY=http://user:pass@host:port
# Строка Cookie из браузера (DevTools → Network → любой запрос к auto.ru → Request Headers → cookie)
AUTORU_COOKIES=
DROM_COOKIES=
